{
  "compilerOptions": {
    "target": "es2016",
    "module": "commonjs",
    "moduleResolution": "node",                     
    "declaration": true,                              
    "outDir": "./build",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "noImplicitAny": true,
},
  "include": ["src/**/*", "**/*.ts"],
  "exclude": ["node_modules", "build"]
}
